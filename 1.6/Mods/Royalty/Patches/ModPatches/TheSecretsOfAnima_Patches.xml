<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>The Secret of Anima - Arsenal</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>Biotech</li>
			</mods>
			<match Class="PatchOperationConditional">
				<xpath>/Defs/ThoughtDef[defName="TSOA_AnimaArrowScream"]/nullifyingGenes</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThoughtDef[defName="TSOA_AnimaArrowScream"]</xpath>
					<value>
						<nullifyingGenes>
							<li>HVT_ASageGene</li>
						</nullifyingGenes>
					</value>
				</nomatch>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/ThoughtDef[defName="TSOA_AnimaArrowScream"]/nullifyingGenes</xpath>
					<value>
						<li>HVT_ASageGene</li>
					</value>
				</match>
			</match>
		</match>
	</Operation>
</Patch>