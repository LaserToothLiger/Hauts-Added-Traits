  <!--DLC or mod-exclusive invalidities-->
  <Operation Class="PatchOperationFindMod">
	<mods>
	  <li>Royalty</li>
	</mods>
	<match Class="PatchOperationSequence">
		<operations>
		  <li Class="PatchOperationConditional">
			<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBecomeNoble"]/invalidTraits</xpath>
			<nomatch Class="PatchOperationAdd">
				<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBecomeNoble"]</xpath>
				<value>
					<invalidTraits>
					  <li>HVT_Humble</li>
					  <li>HVT_Anarchist</li>
					  <li>HVT_Servile</li>
					</invalidTraits>
				</value>
			</nomatch>
			<match Class="PatchOperationAdd">
				<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBecomeNoble"]/invalidTraits</xpath>
				<value>
				  <li>HVT_Humble</li>
				  <li>HVT_Anarchist</li>
				  <li>HVT_Servile</li>
				</value>
			</match>
		  </li>
		  <li Class="PatchOperationAdd">
			<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantHearAnimaScream"]/requiredTraits</xpath>
			<value>
			  <li>HVT_PsychicallyBlank</li>
			</value>
		  </li>
		</operations>
	</match>
  </Operation>
