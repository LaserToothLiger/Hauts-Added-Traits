<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  
  <!--certain traits disable/prevent certain wants
		Allegiant-->
  <Operation Class="PatchOperationConditional">
	<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBanished"]/invalidTraits</xpath>
	<nomatch Class="PatchOperationAdd">
		<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBanished"]</xpath>
		<value>
			<invalidTraits>
			  <li>HVT_Allegiant</li>
			</invalidTraits>
		</value>
	</nomatch>
	<match Class="PatchOperationAdd">
		<xpath>/Defs/WantsAndQuirks.WantDef[defName="WQ_WantBanished"]/invalidTraits</xpath>
		<value>
		  <li>HVT_Allegiant</li>
		</value>
	</match>
  </Operation>
