<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Cybranian - Events</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/GameConditionDef[defName="DeathOfSun" or defName="PsyStorm"]</xpath>
					<value>
						<li Class="HautsTraits.CatastrophistLikedCondition" />
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/GameConditionDef[defName="ClimateChange" or defName="IceStorm"]</xpath>
					<value>
						<li Class="HautsTraits.TempestophileLikedCondition" />
						<li Class="HautsTraits.CatastrophistLikedCondition" />
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>