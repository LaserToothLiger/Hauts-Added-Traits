<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biomes! Polluted Lands</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>Anomaly</li>
			</mods>
			<match Class="PatchOperationAddModExtension">
				<xpath>/Defs/ThoughtDef[defName="BMT_ObservedMaligoat"]</xpath>
				<value>
					<li Class="HautsFramework.ModifyingTraits">
						<forcePositive>
						  <li>HVT_MonsterLover</li>
						</forcePositive>
					</li>
				</value>
			</match>
		</match>
	</Operation>
</Patch>