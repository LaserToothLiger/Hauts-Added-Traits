					<match Class="PatchOperationAdd">
						<xpath>/Defs/MemeDef[defName="Blindsight"]/modExtensions/li[@Class="IdeologyVirtues.DefModExtension_MemeDefVirtues"]/associatedPreferredTraits</xpath>
						<value>
							<HVT_Perceptive>1</HVT_Perceptive>
							<HVT_Perceptive>2</HVT_Perceptive>
						</value>
					</match>
