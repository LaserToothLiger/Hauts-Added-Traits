<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Cybranian - Ideology Virtues</li><!--so whether or not most of this takes effect is mod loading-order dependent. This patch works much better if you load C-IV above HAT, but this truly has such a small impact on gameplay i'm not going to throw a fit and demand it be so.-->
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationConditional"><!--C-IV adds this path but it only has associatedPreferredTraits. If C-IV loaded above HAT, we'll use a conditional to add our disapprovals. If below HAT, doesn't matter - C-IV would override any patch.-->
					<xpath>/Defs/MemeDef[defName="AnimalPersonhood"]/modExtensions/li[@Class="IdeologyVirtues.DefModExtension_MemeDefVirtues"]</xpath>
					<match Class="PatchOperationConditional">
						<xpath>/Defs/MemeDef[defName="AnimalPersonhood"]/modExtensions/li[@Class="IdeologyVirtues.DefModExtension_MemeDefVirtues"]/associatedDisapprovedTraits</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>/Defs/MemeDef[defName="AnimalPersonhood"]/modExtensions/li[@Class="IdeologyVirtues.DefModExtension_MemeDefVirtues"]</xpath>
							<value>
								<associatedDisapprovedTraits>
									<li>HVT_Agrizoophobe</li>
									<li MayRequire="Ludeon.RimWorld.Odyssey">HVT_Angler</li>
									<li MayRequire="Ludeon.RimWorld.Odyssey">HVT_Pescatarian</li>
								</associatedDisapprovedTraits>
							</value>
						</nomatch>
						<match Class="PatchOperationAdd">
							<xpath>/Defs/MemeDef[defName="AnimalPersonhood"]/modExtensions/li[@Class="IdeologyVirtues.DefModExtension_MemeDefVirtues"]/associatedDisapprovedTraits</xpath>
