<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biomes! Core</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!--nothing scary about deep water when you love the open water-->
				<li Class="PatchOperationConditional">
					<xpath>/Defs/ThoughtDef[defName="BiomesCore_AbysalWater"]/nullifyingTraits</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>/Defs/ThoughtDef[defName="BiomesCore_AbysalWater"]</xpath>
						<value>
							<nullifyingTraits>
								<li>HVT_Mariner</li>
								<li>HVT_Outdoorsy</li>
							</nullifyingTraits>
						</value>
					</nomatch>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThoughtDef[defName="BiomesCore_AbysalWater"]/nullifyingTraits</xpath>
						<value>
							<li>HVT_Mariner</li>
							<li>HVT_Outdoorsy</li>
						</value>
					</match>
				</li>
				<!--Mariner loves bathing-->
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThoughtDef[defName="BiomesCore_LagoonWater"]</xpath>
					<value>
						<li Class="HautsFramework.ModifyingTraits">
							<multiplierTraits>
							  <li>
								<key>HVT_Mariner</key>
								<value>2</value>
							  </li>
							</multiplierTraits>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>